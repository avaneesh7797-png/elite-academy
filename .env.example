# Vercel Postgres exposes these automatically when you provision a database
# from the Vercel dashboard. For local Postgres / Neon / Supabase, set them
# manually. Both are required.
POSTGRES_PRISMA_URL="postgres://user:pass@host/db?pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgres://user:pass@host/db"

# A long random string. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# The full URL where the app is hosted. Vercel auto-fills this for previews
# and production via the VERCEL_URL env var, but set this in production.
NEXTAUTH_URL="http://localhost:3000"

# --- Emergency app: PayU India (dynamic checkout, optional) ---
# Only needed for the hash-signed API checkout flow. The default flow
# uses a PayU hosted payment link (NEXT_PUBLIC_PAYU_PAYMENT_LINK below).
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
PAYU_MODE="test"   # "test" hits test.payu.in; "live" hits secure.payu.in

# --- Emergency app: PayU hosted payment link (default flow) ---
# The "Pay Now" button on /emergency/upgrade opens this URL.
# Pricing is a single one-time payment with lifetime access.
NEXT_PUBLIC_PAYU_PAYMENT_LINK="https://u.payu.in/sIgRPWiRGhbM"
NEXT_PUBLIC_PAYU_PAYMENT_AMOUNT="2000"
NEXT_PUBLIC_PAYU_PAYMENT_LABEL="Premium · Lifetime"
NEXT_PUBLIC_PAYU_PAYMENT_PERIOD_DAYS="36500"

# Email of the account allowed to view /emergency/admin/subscriptions
# and activate pending payments. Leave blank to disable admin features.
ADMIN_EMAIL=""
