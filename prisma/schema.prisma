generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  image         String?
  createdAt     DateTime  @default(now())

  listings           Listing[] @relation("SellerListings")
  bids               Bid[]
  watches            Watch[]
  notifications      Notification[]
  emergencyContacts  EmergencyContact[]
  medicalProfile     MedicalProfile?
  emergencySettings  EmergencySettings?
  subscriptions      Subscription[]
  ownedFamilies      Family[]           @relation("OwnedFamilies")
  familyMemberships  FamilyMember[]
  memberLocations    MemberLocation[]
  familyAlerts       FamilyAlert[]
}

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  relationship String   @default("")
  position     Int      @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([userId, position])
}

model MedicalProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String   @default("")
  dob             String   @default("")
  bloodType       String   @default("")
  weight          String   @default("")
  height          String   @default("")
  allergies       String   @default("")
  conditions      String   @default("")
  medications     String   @default("")
  doctorName      String   @default("")
  doctorPhone     String   @default("")
  insurance       String   @default("")
  iceName         String   @default("")
  iceRelationship String   @default("")
  icePhone        String   @default("")
  notes           String   @default("")
  updatedAt       DateTime @updatedAt
}

model EmergencySettings {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalNumber  String   @default("911")
  fireNumber     String   @default("911")
  policeNumber   String   @default("911")
  country        String   @default("US")
  shareLocation  Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               String
  status             String   @default("pending")
  payuTxnId          String   @unique
  payuPaymentId      String?
  amount             Float
  currency           String   @default("INR")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, currentPeriodEnd])
}

model Family {
  id         String   @id @default(cuid())
  name       String   @default("My Circle")
  ownerId    String
  owner      User     @relation("OwnedFamilies", fields: [ownerId], references: [id], onDelete: Cascade)
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members   FamilyMember[]
  locations MemberLocation[]
  alerts    FamilyAlert[]
}

model FamilyMember {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("member")
  nickname  String   @default("")
  joinedAt  DateTime @default(now())

  @@unique([familyId, userId])
  @@index([userId])
}

model MemberLocation {
  id        String   @id @default(cuid())
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat       Float
  lon       Float
  accuracy  Float?
  updatedAt DateTime @updatedAt

  @@unique([familyId, userId])
}

model FamilyAlert {
  id             String    @id @default(cuid())
  familyId       String
  family         Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String    @default("sos")
  message        String    @default("")
  lat            Float?
  lon            Float?
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?

  @@index([familyId, createdAt])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  listings Listing[]
}

model Listing {
  id            String    @id @default(cuid())
  title         String
  description   String
  condition     String    @default("USED")
  imageUrl      String
  startPrice    Float
  currentPrice  Float
  buyNowPrice   Float?
  endsAt        DateTime
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())

  sellerId      String
  seller        User      @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)

  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])

  winnerId      String?

  bids          Bid[]
  watches       Watch[]

  @@index([status])
  @@index([categoryId])
  @@index([endsAt])
}

model Bid {
  id        String   @id @default(cuid())
  amount    Float
  createdAt DateTime @default(now())

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  bidderId  String
  bidder    User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

model Watch {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
